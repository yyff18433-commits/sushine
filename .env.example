# 可选：不建这个文件也能跑 —— DeepSeek 的 key 写在 server/aiConfig.js，
# 看图识别用的是浏览器本地 CLIP，不需要任何 key。
#
# 注意：不要加 VITE_ 前缀，这些只在 dev server 里读，不会打进前端包。

# ---- 文本模型（写备注 / 回答追问）----
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# ---- 本地视觉模型的下载源 ----
# huggingface.co 国内基本连不上；hf-mirror.com 能下但没有 CORS 头，
# 所以统一由 dev server 的 /api/model 代理转发。
AI_MODEL_MIRROR=https://hf-mirror.com

# ---- 可选：服务端视觉模型（配了就不用浏览器本地跑，质量更好）----
# 三个都填才会启用；否则 /api/recognize 返回 no-vision，前端自动转本地 CLIP
#   阿里百炼  AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#             AI_VISION_MODEL=qwen-vl-max
#   智谱 GLM  AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#             AI_VISION_MODEL=glm-4v-plus
#   OpenAI    AI_VISION_BASE_URL=https://api.openai.com/v1
#             AI_VISION_MODEL=gpt-4o-mini
AI_VISION_BASE_URL=
AI_VISION_KEY=
AI_VISION_MODEL=

# 不联网跑通链路：返回固定样例
AI_MOCK=0
